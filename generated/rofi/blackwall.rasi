/* Generated by tools/generate.py from theme/palette.json + settings.json. Do not edit. */
* {
    base: #07070AA6;
    surface: #111116;
    overlay: #1C1C24;
    text: #E6E1E3;
    muted: #6E6A75;
    red: #FF0033;
    red-dim: #7A0019;
    background-color: transparent;
    text-color: @text;
    font: "JetBrainsMono Nerd Font 11";
}
window {
    location: center;
    width: 680px;
    background-color: @base;
    border: 1px;
    border-color: @red-dim;
    border-radius: 12px;
}
mainbox { padding: 12px; spacing: 8px; children: [ inputbar, listview ]; }
inputbar {
    padding: 8px 12px;
    spacing: 10px;
    background-color: @surface;
    border: 1px;
    border-color: @overlay;
    border-radius: 6px;
    children: [ prompt, entry ];
}
prompt { text-color: @red; }
entry { placeholder: "search history"; placeholder-color: @muted; }
listview { lines: 10; columns: 1; scrollbar: false; fixed-height: false; spacing: 2px; }
element { padding: 7px 12px; border-radius: 6px; }
element selected.normal { background-color: @red; text-color: #07070A; }
element-text { background-color: transparent; text-color: inherit; }
